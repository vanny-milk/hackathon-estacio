# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - HACKATHON ESTÁCIO
# ==============================================================================
# IMPORTANTE: Copie este arquivo para .env e preencha os valores locais.
# NUNCA comite o arquivo .env com credenciais reais no repositório!
# ==============================================================================

# Aplicação
NODE_ENV=development
APP_NAME="Hackathon Estácio App"
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=/api/v1

# Segurança e Autenticação
JWT_SECRET=substitua-por-um-segredo-forte-de-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Banco de Dados (Exemplo PostgreSQL / MySQL / SQLite)
DATABASE_DRIVER=postgresql
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=hackathon_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hackathon_db

# Logs e Monitoramento
LOG_LEVEL=debug
ENABLE_TELEMETRY=false
